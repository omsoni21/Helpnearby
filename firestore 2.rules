rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Admin role MUST come from trusted server-set custom claims, never client document fields
    function isServerAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'MEMBER'
        && request.resource.data.isSuspended == false;
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isSuspended == resource.data.isSuspended;
      allow delete: if isOwner(userId);

      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /help_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.status != 'UNDER_REVIEW' || isOwner(resource.data.ownerId) || isServerAdmin());
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5;
      allow update, delete: if isOwner(resource.data.ownerId) || isServerAdmin();

      match /offers/{offerId} {
        allow read: if isSignedIn()
          && (request.auth.uid == resource.data.volunteerId
              || request.auth.uid == get(/databases/$(database)/documents/help_requests/$(requestId)).data.ownerId);
        allow create: if isSignedIn() && request.resource.data.volunteerId == request.auth.uid;
        allow update: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/help_requests/$(requestId)).data.ownerId;
      }
    }

    match /volunteer_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.verificationStatus == (resource == null ? 'UNVERIFIED' : resource.data.verificationStatus);
    }

    match /donor_profiles/{userId} {
      allow read: if isSignedIn() && (resource.data.consent == true || isOwner(userId));
      allow create, update: if isOwner(userId) && request.resource.data.consent == true;
      allow delete: if isOwner(userId);
    }

    match /donor_contact_requests/{reqId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.donorId || request.auth.uid == resource.data.requesterId);
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.donorId;
    }

    match /lost_found_posts/{postId} {
      allow read: if isSignedIn() && resource.data.status != 'UNDER_REVIEW';
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId) || isServerAdmin();
    }

    match /community_posts/{postId} {
      allow read: if isSignedIn() && resource.data.status == 'ACTIVE';
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId) || isServerAdmin();
    }

    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn();
    }

    match /user_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isServerAdmin();
    }

    match /blocked_users/{blockId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.blockerId;
      allow create: if isSignedIn() && request.resource.data.blockerId == request.auth.uid;
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isServerAdmin();
    }
  }
}
